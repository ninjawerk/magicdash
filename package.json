{
  "name": "magicdash",
  "version": "0.2.0",
  "private": true,
  "description": "A plugin-based kiosk dashboard for Raspberry Pi: schedule, weather, Home Assistant and more.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "new-plugin": "tsx scripts/new-plugin.ts",
    "pack-plugin": "tsx scripts/pack-plugin.ts",
    "mcp": "tsx mcp/server.ts",
    "mcp:test": "tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^0.475.0",
    "node-ical": "^0.27.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-grid-layout": "^1.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ninjawerk/magicdash.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/ninjawerk/magicdash#readme"
}
